---
import "$lib/styles/global.css";
import data from "$lib/config/data";
import { SEO } from "astro-seo";
import Logo from "$lib/components/Logo.astro";
import Navigator from "$lib/components/Navigator.astro";
import Footer from "$lib/components/Footer.astro";
interface Props {
  title?: string;
  dark?: boolean;
  projects?: boolean;
  nav?: boolean;
  description?: string;
  image?: string;
  noindex?: boolean;
}
const {
  title,
  description,
  image = `${data.s3Bucket}/scanlabprojects.jpg`,
  noindex = false,
  dark = false,
  projects = true,
  nav = true,
} = Astro.props;
const fullTitle = title ? `${title} | ScanLAB Projects` : "ScanLAB Projects";
---

<!doctype html>
<html lang="en">
  <head>
    <SEO
      title={fullTitle}
      {description}
      {noindex}
      openGraph={{
        basic: {
          title: fullTitle,
          type: "website",
          image,
        },
        optional: {
          siteName: "ScanLAB Projects",
        },
      }}
      twitter={{
        card: "summary_large_image",
        title: fullTitle,
        description,
        image,
      }}
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6L28TGXHFS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-6L28TGXHFS');
    </script>
  </head>
  <body>
    {
      nav && (
        <Navigator>
          <Logo {dark} />
        </Navigator>
      )
    }
    <slot />
    <Footer link={projects} />
  </body>
</html>
<style is:global>
  html {
    background: #fff;
    font-size: var(--size-base);
  }
  html.is-static {
    overflow-y: hidden;
  }
  html[mobile="true"] {
    footer {
      display: none;
    }
  }
  /* has-hero */
  nav:has(~ header) {
    --nav-hover: var(--col-white);
  }

  body {
    position: relative;
    margin: 0;
    overflow-x: hidden;
  }

  .bold {
    font-weight: bold;
  }
</style>
