---
import { getCollection, getEntry } from "astro:content";
import { getImage } from "astro:assets";
import Layout from "$lib/layouts/BaseLayout.astro";
import Hero from "$lib/components/Hero.astro";
export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map(({ slug, data }) => {
    return {
      params: { slug },
      props: { ...data },
    };
  });
}
const slug = Astro.params.slug;
const mdx = await getEntry("projects", slug);
const { Content } = (await mdx?.render()) || { Content: "" };
const {
  heading,
  title,
  seoTitle,
  vimeo,
  client,
  subtitle,
  tags,
  background,
  description,
  date,
  link,
  noindex,
} = Astro.props;
const image = background ? `${slug}/${background}` : null;
const bgs = import.meta.glob<{ default: ImageMetadata }>(
  `/src/assets/projects/**/*.jpg`
);
let hero;
if (image) {
  hero = await bgs[`/src/assets/projects/${image}`]();
}
const shareSource =
  hero ?? (await bgs[`/src/assets/projects/${slug}/banner.jpg`]?.());
const shareImage = shareSource
  ? new URL(
      (await getImage({ src: shareSource.default, width: 1200, format: "jpg" }))
        .src,
      Astro.site
    ).href
  : undefined;
const work = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description: description || undefined,
  image: shareImage,
  url: new URL(Astro.url.pathname, Astro.site).href,
  creator: { "@id": new URL("/#organization", Astro.site).href },
};
---

<Layout
  dark={false}
  title={seoTitle ?? title}
  {description}
  image={shareImage}
  {noindex}
  schema={work}
>
  <Hero
    projectpage={true}
    {heading}
    {title}
    {link}
    {tags}
    {date}
    {vimeo}
    background={hero?.default}
    {client}
    {subtitle}
  />
  <main>
    <!-- {
      date && (
        <date class="text-xs text-right">
          <span class="border rounded-md p-2">{date}</span>
        </date>
      )
    } -->
    <Content />
  </main>
</Layout>

<style>
  date {
    /* border-bottom: 1px solid rgba(0, 0, 0, 0.25); */
  }
</style>
