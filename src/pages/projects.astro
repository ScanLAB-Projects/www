---
import Layout from "$lib/layouts/BaseLayout.astro";
import ProjectThumbs from "$lib/components/ProjectThumbs.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<Layout
  title="Projects"
  dark={true}
  projects={false}
  description="Artworks, films and installations by ScanLAB Projects, an artist-led studio exploring the world through 3D scanning and machine vision."
>
  <ProjectThumbs projects={projects} />
</Layout>
